# FlintRTOS - editor defaults (keeps line endings & indentation consistent).
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Makefiles require literal tabs.
[Makefile]
indent_style = tab

# Windows scripts use CRLF.
[*.{bat,cmd,ps1}]
end_of_line = crlf
